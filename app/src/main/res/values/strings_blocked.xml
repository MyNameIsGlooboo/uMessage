<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- %1$s lists sender names such as "BANK-X". -->
    <string name="spam_allow_spoof_warning">Anyone can send a text under a name like %1$s. Allowing it also lets fake texts using that name through.</string>
    <plurals name="spam_snack_restored_to_inbox">
        <item quantity="one">%d message restored to the inbox</item>
        <item quantity="other">%d messages restored to the inbox</item>
    </plurals>
    <!-- After Not spam when nothing could be put in the inbox, but the senders were allowed. -->
    <plurals name="spam_snack_allowed_only">
        <item quantity="one">%d sender is now always allowed.</item>
        <item quantity="other">%d senders are now always allowed.</item>
    </plurals>
    <!-- Added after the restored text when some picture messages (MMS) came back without their pictures. -->
    <plurals name="spam_snack_media_lost">
        <item quantity="one">The picture could not be recovered for %d message.</item>
        <item quantity="other">The pictures could not be recovered for %d messages.</item>
    </plurals>
    <!-- After Not spam when the picture messages had no text and their pictures were not downloaded. -->
    <plurals name="spam_snack_media_lost_nothing">
        <item quantity="one">The picture message could not be recovered, so nothing was added to the inbox.</item>
        <item quantity="other">%d picture messages could not be recovered, so nothing was added to the inbox.</item>
    </plurals>
    <!-- A kept picture message could not be written to the inbox; it stays on the Blocked screen. -->
    <plurals name="spam_snack_restore_failed">
        <item quantity="one">%d picture message could not be restored. It is still here.</item>
        <item quantity="other">%d picture messages could not be restored. They are still here.</item>
    </plurals>

    <!-- What is kept of a blocked picture message (MMS), shown on its row. -->
    <string name="spam_mms_stored">Picture message</string>
    <string name="spam_mms_downloading">Picture message, downloading</string>
    <string name="spam_mms_missing">Picture message, not downloaded</string>
    <string name="spam_mms_thumbnail">Picture in the blocked message</string>

    <!-- Why a message was blocked (SU-22). %1$s is the rule's text. -->
    <string name="spam_reason_rule_keyword">Rule: keyword \"%1$s\"</string>
    <string name="spam_reason_rule_regex">Rule: pattern %1$s</string>
    <string name="spam_reason_rule_number">Rule: number %1$s</string>
    <string name="spam_reason_rule_prefix">Rule: numbers starting %1$s</string>
    <string name="spam_reason_rule_sender">Rule: sender %1$s</string>
    <string name="spam_reason_rule_removed">Rule since removed</string>
    <string name="spam_reason_open_rules">Open rules</string>

    <!-- Auto-delete of blocked messages (SU-23). -->
    <plurals name="spam_purge_notice">
        <item quantity="one">Spam is deleted after %d day</item>
        <item quantity="other">Spam is deleted after %d days</item>
    </plurals>
    <plurals name="spam_purge_left">
        <item quantity="one">Deleted in %d day</item>
        <item quantity="other">Deleted in %d days</item>
    </plurals>
    <string name="spam_purge_left_today">Deleted today</string>

    <!-- "Report spam" in the conversation list selection (MC-37). -->
    <plurals name="convlist_reported_spam_archived">
        <item quantity="one">Reported. New texts from this sender go to Spam, and the chat is archived.</item>
        <item quantity="other">%d chats reported. New texts from them go to Spam, and the chats are archived.</item>
    </plurals>
    <plurals name="convlist_reported_spam">
        <item quantity="one">Reported. New texts from this sender go to Spam.</item>
        <item quantity="other">%d chats reported. New texts from them go to Spam.</item>
    </plurals>

    <!-- Blocked tab and screen, design review 2 (BR-*, P1-*). -->
    <string name="blocked_title">Spam</string>
    <!-- Group name for the mode selector: "Unknown senders: Smart, 2 of 3". -->
    <!-- %1$s is the new mode name. -->
    <string name="blocked_snack_mode">Unknown senders set to %1$s</string>
    <string name="blocked_stats_restored">%1$d restored by you</string>
    <string name="blocked_reason_unknown_link">Unknown sender, with a link</string>
    <string name="blocked_may_be_important">May be important</string>
    <string name="blocked_action_move_inbox">Move to inbox</string>
</resources>
