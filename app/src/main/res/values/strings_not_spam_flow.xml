<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Snackbar after Not spam: the messages moved to the inbox (with Undo). -->
    <string name="nsf_snack_moved">Moved to Messages</string>
    <!-- %1$s is the sender's number or name. -->
    <string name="nsf_snack_moved_allowed">Moved to Messages. %1$s is now always allowed.</string>
    <plurals name="nsf_snack_moved_allowed_many">
        <item quantity="one">Moved to Messages. %d sender is now always allowed.</item>
        <item quantity="other">Moved to Messages. %d senders are now always allowed.</item>
    </plurals>
    <!-- Shown while Not spam is working. -->
    <string name="nsf_moving">Moving to inbox</string>
    <!-- Progress strip while "Not spam" moves many messages: first number done, second total. -->
    <string name="move_progress">Moving messages: %1$s of %2$s</string>
</resources>
