<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- main-21: snackbar after "Mark all read" in the inbox menu; Undo makes exactly those chats unread again. -->
    <plurals name="decm_marked_all_read">
        <item quantity="one">%d chat marked as read</item>
        <item quantity="other">%d chats marked as read</item>
    </plurals>

    <!-- Progress strip above the chat list while "Mark all read" works: first number done, second total. -->
    <string name="mark_read_progress">Marking chats as read: %1$s of %2$s</string>

    <!-- spamui-20: search box of the Blocked screen. -->
    <string name="decm_blocked_search">Search Spam</string>
    <string name="decm_blocked_search_hint">Search by sender or text</string>
    <string name="decm_blocked_search_close">Close search</string>
    <string name="decm_blocked_search_none_title">Nothing found</string>
    <string name="decm_blocked_search_none_body">No sender or text in Spam matches what you typed.</string>

    <!-- spamui-21: button of the Why-blocked dialog; it allows the sender for good. -->
    <string name="decm_always_allow">Always allow</string>
</resources>
