    </plurals>

    <!-- Shown after the app lock is set up -->
    <string name="lock_setup_done">App lock is on. If you forget your PIN or pattern, tap \"Forgot it?\" on the lock screen and use your phone\'s screen lock instead.</string>
    <string name="lock_setup_done_biometric">App lock is on. If biometrics stop working, use your backup PIN. If you forget that too, tap \"Forgot it?\" and use your phone\'s screen lock.</string>
    <string name="lock_setup_done_no_screen_lock">App lock is on. Your phone has no screen lock, so if you forget your PIN or pattern there is no other way in: you would have to clear uMessage\'s data in the phone\'s app settings, which deletes its settings, spam lists and spam history (your text messages stay on the phone). Add a screen lock to your phone to have a way back in.</string>

    <!-- App lock options in Settings -->
    <string name="settings_app_lock_timeout">Lock after leaving the app</string>
    <string name="settings_app_lock_timeout_immediately">Immediately</string>
    <string name="settings_app_lock_timeout_30s">After 30 seconds</string>
    <string name="settings_app_lock_timeout_1m">After 1 minute</string>
    <string name="settings_app_lock_timeout_5m">After 5 minutes</string>
    <string name="settings_app_lock_screenshots">Block screenshots</string>
    <string name="settings_app_lock_screenshots_body">Stops screenshots and screen recording. Messages are always hidden in recent apps.</string>
    <string name="settings_app_lock_change">Change PIN, pattern or biometrics</string>
    <string name="settings_app_lock_weak">Your PIN or pattern is easy to guess</string>
    <string name="settings_app_lock_weak_body">PIN too weak. Tap to change</string>
    <string name="settings_app_lock_add_pin">Add a backup PIN</string>
    <string name="settings_app_lock_add_pin_body">Add a PIN as a backup</string>
