    <string name="lock_use_pin_instead">Use PIN instead</string>
    <string name="lock_use_biometrics_instead">Use biometrics instead</string>
    <string name="lock_use_screen_lock">Use phone screen lock instead</string>
    <string name="lock_biometrics_unavailable">Biometrics are not available. Enter your PIN.</string>
    <string name="lock_screen_lock_title">Open uMessage</string>
    <string name="lock_screen_lock_description">Confirm your phone screen lock to open uMessage</string>
    <string name="lock_no_way_to_check">This phone no longer has fingerprints or a screen lock, so uMessage cannot check it\'s you. Open it and set a PIN in Settings.</string>
