<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+). Nothing from the app's private storage leaves the device:
    not to Google cloud backup and not in a device-to-device transfer.
    This covers spamless.db (+ -wal/-shm, blocked message bodies), conversations.db,
    files/spamless_decisions.log (sender numbers) and the shared prefs, which hold the
    app-lock PIN hash. SMS/MMS themselves live in the system Telephony provider and are
    not affected by this file. allowBackup="false" alone does not stop device transfer
    on API 31+, so every domain is excluded here as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
