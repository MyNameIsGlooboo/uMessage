<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (API 30-). allowBackup="false" already turns auto backup off;
    this file is a second guard in case that flag is ever flipped. It excludes every
    domain, so spamless.db, conversations.db, files/spamless_decisions.log and the
    shared prefs (app-lock PIN hash) are never backed up. See data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
