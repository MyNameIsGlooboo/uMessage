<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pt_onb_filter_on">알 수 없는 발신자를 스팸함으로 분류</string>
    <string name="pt_onb_filter_on_desc">연락처, 내가 문자를 보낸 사람, 인증 코드를 보낸 발신자는 메시지 탭에 남아요.</string>
    <string name="pt_onb_filter_off">모두 메시지 탭에 두기</string>
    <string name="pt_onb_filter_off_desc">내가 차단한 발신자만 스팸함으로 가요.</string>
    <string name="pt_onb_filter_hint">나중에 설정에서 바꿀 수 있어요.</string>
    <string name="pt_onb_demo_desc_off">모든 문자가 메시지 탭으로 가요. 내가 차단한 발신자만 스팸함으로 가요.</string>
    <string name="pt_filter_on_summary">켜짐: 알 수 없는 발신자는 스팸함으로 가요</string>
    <string name="pt_filter_off_summary">꺼짐: 차단한 발신자를 빼고 모두 메시지 탭으로 와요</string>
    <string name="pt_filter_off_confirm_title">스팸 필터를 끌까요?</string>
    <plurals name="pt_filter_off_confirm_body">
        <item quantity="other">대화 %d개가 스팸함에서 메시지 탭으로 이동해요. 차단한 발신자의 대화는 스팸함에 남아요.</item>
    </plurals>
    <string name="pt_filter_on_confirm_title">스팸 필터를 켤까요?</string>
    <plurals name="pt_filter_on_confirm_body">
        <item quantity="other">알 수 없는 발신자의 대화 %d개가 스팸함으로 이동해요. 삭제되는 것은 없어요.</item>
    </plurals>
    <string name="pt_confirm_none_move">지금 이동하는 대화는 없어요.</string>
    <string name="pt_turn_off">끄기</string>
    <string name="pt_purge_warn_title">오래된 스팸을 자동으로 삭제할까요?</string>
    <plurals name="pt_purge_warn_body">
        <item quantity="other">스팸함에 온 지 %d일이 지난 문자는 휴대전화 자체에서 삭제되어 모든 앱에서 사라져요. 다시 되돌릴 수 없어요. 내가 보낸 문자, 별표한 문자, 메모를 단 문자는 남아요.</item>
    </plurals>
    <string name="pt_group_code_title">인증 코드를 보낸 발신자</string>
    <string name="pt_group_wrote_title">내가 문자를 보낸 사람</string>
    <plurals name="pt_group_count">
        <item quantity="other">발신자 %d명</item>
    </plurals>
    <string name="pt_group_code_body">인증 코드를 보낸 발신자는 그때부터 허용돼요. 여기서 삭제하거나 해당 대화에서 차단하세요.</string>
    <string name="pt_group_wrote_body">내가 문자를 보낸 번호는 그때부터 허용돼요. 여기서 삭제하거나 해당 대화에서 차단하세요.</string>
    <string name="pt_group_member_remove">삭제</string>
    <string name="pt_group_member_removed">목록에서 %1$s 삭제함</string>
    <string name="pt_group_member_history">예전 문자에서 찾음</string>
    <string name="pt_group_empty">아직 아무도 없어요</string>
    <string name="pt_group_off_title">‘%1$s’을(를) 끌까요?</string>
    <plurals name="pt_group_off_body">
        <item quantity="other">대화 %d개가 스팸함으로 이동해요. 발신자는 목록에 남고, 다시 켜면 돌아와요.</item>
    </plurals>
    <string name="pt_group_off_code_note">그러면 알 수 없는 발신자의 인증 코드도 스팸함으로 가요.</string>
    <string name="pt_verdict_group">메시지 탭으로 가요. 발신자가 ‘%1$s’에 있어요.</string>
    <string name="pt_verdict_allowed_word">메시지 탭으로 가요. 문자에 허용 단어가 들어 있어요. 이후 이 발신자는 허용돼요.</string>
    <string name="pt_verdict_blocked_word">스팸함으로 가요. 문자에 차단 단어가 들어 있어요. 이후 이 발신자는 차단돼요.</string>
    <string name="pt_progress_title">대화를 분류하는 중</string>
    <string name="pt_progress_body">한 번만 진행돼요. 끝날 때까지 대화는 이동하지 않고, 삭제되는 것도 없어요.</string>
