    <string name="rules2_sheet_list_label">목록에 추가</string>
    <string name="rules2_sheet_list_allow">항상 허용</string>
    <string name="rules2_sheet_list_block">항상 차단</string>
    <string name="rules2_sheet_delete">규칙 삭제</string>
    <string name="rules2_sheet_hint_empty">계속하려면 값을 입력해요.</string>
    <string name="rules2_sheet_hint_fix">계속하려면 위의 값을 수정해요.</string>
    <string name="rules2_sheet_sim_help">특정 SIM 전용 규칙은 해당 SIM 카드로 받은 메시지에만 적용돼요.</string>
    <string name="rules2_type_number_help">정확한 전화번호를 입력해요. 예: +15550001234 또는 05550001234. 3000 같은 단축 번호도 가능해요. 페르시아 숫자도 쓸 수 있어요.</string>
    <string name="rules2_type_number_hint">+15550001234</string>
    <string name="rules2_type_prefix_help">입력한 숫자로 시작하는 모든 번호에 적용돼요. 예: +1555 또는 0555.</string>
    <string name="rules2_type_prefix_hint">+1555</string>
    <string name="rules2_type_sender_id_help">VM-HDFCBK 또는 Bank Melli 같은 문자 발신자예요. 대소문자는 구분하지 않아요.</string>
    <string name="rules2_type_regex_help">고급 기능이에요. 메시지 내용과 일치하는지 확인할 정규식이에요. 저장하기 전에 아래에서 테스트해요.</string>
    <string name="rules2_err_sender_id">문자, 숫자, 공백, 점, 대시 또는 &amp; 기호를 사용해요. (최대 32글자, 문자 1개 이상 포함)</string>
    <string name="rules2_err_sender_id_char">발신자 이름에 \"%1$s\" 기호는 사용할 수 없어요. 문자, 숫자, 공백, 점, 대시 또는 &amp; 기호를 사용해요.</string>
    <string name="rules2_test_label">예시 메시지로 테스트</string>
    <string name="rules2_test_hint">이 규칙을 테스트할 메시지를 붙여넣거나 입력해요.</string>
    <string name="rules2_test_match">이 메시지는 규칙과 일치해요.</string>
    <string name="rules2_test_no_match">이 메시지는 규칙과 일치하지 않아요.</string>
    <string name="rules2_test_unusable">이 정규식은 테스트할 수 없어요. 위에서 확인해요.</string>
    <string name="rules2_bn_title">Android 차단 목록</string>
    <string name="rules2_bn_info">Android 시스템에 저장돼요. 이 번호들의 전화와 문자를 차단해요. uMessage 규칙은 별도예요.</string>
    <plurals name="rules2_bn_move">
        <item quantity="other">번호 %1$d개를 규칙으로 이동</item>
    </plurals>
    <string name="forward2_intro_reassure">받은 메시지함에 도착한 메시지만 전달해요. 차단된 스팸은 절대 전달하지 않아요.</string>
    <string name="forward2_empty_title">아직 전달 규칙 없음</string>
    <string name="forward2_empty_body">은행 알림처럼 조건에 맞는 메시지의 사본을 다른 휴대전화로 보내요. 아래에서 하나를 선택해 시작해요.</string>
    <string name="forward2_template_bank">은행 알림 전달</string>
    <string name="forward2_template_bank_word">은행</string>
    <string name="forward2_template_sender">특정 발신자 메시지 전달</string>
    <string name="forward2_save">전달 규칙 저장</string>
    <string name="forward2_hint_condition">조건에 맞출 발신자나 내용을 선택해요.</string>
    <string name="forward2_hint_target">전달받을 전화번호를 추가해요.</string>
    <string name="forward2_hint_fix">빨간색으로 표시된 항목을 수정해요.</string>
    <string name="forward2_condition_why">전달할 때마다 SMS 요금이 부과되므로 모든 메시지를 전달할 수는 없어요.</string>
    <string name="forward2_broad_title">많은 메시지를 전달할까요?</string>
    <string name="forward2_broad_message">이 규칙은 발신자 제한이 없어 매우 많은 메시지와 일치해요. 일치하는 메시지는 모두 유료 SMS 방식으로 전달돼요.</string>
    <string name="forward2_broad_confirm">계속 저장</string>
    <string name="forward2_broad_inline">매우 흔한 내용이며 모든 발신자에게 적용돼요. 많은 메시지가 전달되어 요금이 많이 나올 수 있어요.</string>
    <string name="forward2_target_own">본인의 번호예요. 본인에게 전달하면 무한 반복돼요.</string>
    <string name="forward2_target_sender">이 규칙의 대상 발신자 번호예요. 이 번호로 전달하면 무한 반복돼요.</string>
    <string name="forward2_target_ok">유효한 번호</string>
    <string name="forward2_pick_contact">연락처에서 선택</string>
    <plurals name="forward2_cost_estimate">
        <item quantity="other">번호 %1$d개: 메시지 하나를 전달할 때마다 SMS 최소 %1$d건이 발송돼요.</item>
    </plurals>
    <string name="forward2_window_help">예: 22:00~06:00으로 설정하면 밤사이에 전달해요.</string>
    <string name="forward2_window_summary">매일 %1$s~%2$s에 전달해요.</string>
    <string name="forward2_window_summary_night">매일 밤 %1$s~%2$s에 전달해요.</string>
    <string name="forward2_scope_help">메시지를 받을 SIM 카드를 선택해요.</string>
    <string name="forward2_send_help">\"동일한 SIM\"은 메시지를 받은 SIM 카드로 전달해요. 잔액이 없는 SIM 카드로는 보낼 수 없어요.</string>
    <string name="forward2_codes_title">인증 코드(OTP) 전달</string>
    <string name="forward2_codes_off">사용 안 함: 로그인 코드와 인증 코드는 절대 전달하지 않아요.</string>
    <string name="forward2_codes_on">사용: 코드도 전달해요. 코드로 계정에 접근할 수 있으니 본인 기기에만 전달해요.</string>
</resources>
