    <string name="onb_hero_description">帶有勾號的uMessage盾牌</string>
    <string name="onb_welcome_title">歡迎使用uMessage</string>
    <string name="onb_welcome_intro">更好的訊息體驗，更少的垃圾簡訊。</string>
    <string name="onb_welcome_spam">擋下垃圾簡訊</string>
    <string name="onb_welcome_spam_desc">未知寄件者的訊息會留在「已封鎖」，不會遺失。你可以選擇嚴格、智慧或關閉。</string>
    <string name="onb_welcome_codes">一鍵複製驗證碼</string>
    <string name="onb_welcome_codes_desc">直接從通知複製驗證碼。</string>
    <string name="onb_welcome_copy">只複製需要的部分</string>
    <string name="onb_welcome_copy_desc">選取訊息的一部分，只複製那一段。</string>
    <string name="onb_welcome_rules">自訂規則</string>
    <string name="onb_welcome_rules_desc">一律允許或一律封鎖特定寄件者、字詞或模式。</string>
    <string name="onb_welcome_forwarding">自動轉寄</string>
    <string name="onb_welcome_forwarding_desc">將選定的訊息傳送到另一個號碼，並以你的PIN保護。</string>
    <string name="onb_welcome_schedule">排程與雙SIM卡</string>
    <string name="onb_welcome_schedule_desc">稍後傳送，並為每個對話選擇SIM卡。</string>
    <string name="onb_welcome_lock">應用程式鎖與備份</string>
    <string name="onb_welcome_lock_desc">使用PIN或指紋鎖定，並備份到檔案。</string>
    <string name="onb_welcome_private">隱私優先設計</string>
    <string name="onb_welcome_private_desc">無需帳戶、沒有廣告、不用雲端。所有資料都留在你的手機上。</string>
    <string name="onb_welcome_start">開始使用</string>
    <string name="onb_default_title">將uMessage設為簡訊應用程式</string>
    <string name="onb_default_body">Android只允許預設簡訊應用程式接收及篩選訊息。如果不設定，uMessage就無法保護你的收件匣。</string>
    <string name="onb_default_status_yes">uMessage是你的預設簡訊應用程式</string>
    <string name="onb_default_status_no">uMessage尚未設為預設簡訊應用程式</string>
    <string name="onb_default_action">設為預設</string>
    <string name="onb_default_denied">要求遭到拒絕。你可以再試一次，或先繼續，之後在Android設定中設定。</string>
    <string name="onb_default_unavailable">你的手機無法開啟預設應用程式對話框。請開啟Android設定，依序點選「應用程式」、「預設應用程式」、「簡訊應用程式」，然後選擇uMessage。</string>
    <string name="onb_default_open_settings">開啟預設應用程式</string>
    <string name="onb_perm_title">允許uMessage所需的權限</string>
    <string name="onb_perm_body">每項權限都只有一個用途。你隨時可以在Android設定中變更。</string>
    <string name="onb_perm_contacts">聯絡人</string>
    <string name="onb_perm_contacts_reason">讓聯絡人的訊息通過篩選，並顯示他們的名稱。</string>
    <string name="onb_perm_sms">訊息</string>
    <string name="onb_perm_sms_reason">讀取、接收及傳送你的簡訊。</string>
    <string name="onb_perm_phone">電話狀態</string>
    <string name="onb_perm_phone_reason">偵測你的SIM卡，讓雙SIM卡手機能選對卡片。</string>
    <string name="onb_perm_notifications">通知</string>
    <string name="onb_perm_notifications_reason">收到新訊息時提醒你，並提供回覆及複製驗證碼按鈕。</string>
    <string name="onb_perm_allowed">已允許</string>
    <string name="onb_perm_not_allowed">尚未允許</string>
    <string name="onb_perm_blocked">已在設定中封鎖</string>
    <string name="onb_perm_allow">允許</string>
    <string name="onb_perm_allow_all">全部允許</string>
    <string name="onb_perm_open_settings">開啟設定</string>
    <string name="onb_perm_state_cd">%1$s: %2$s</string>
    <string name="onb_mode_title">選擇如何處理未知寄件者</string>
    <string name="onb_mode_body">未知寄件者是指不在你的聯絡人中，而且你從未傳過簡訊的號碼。</string>
    <string name="onb_mode_strict">嚴格</string>
    <string name="onb_mode_strict_desc">將未知寄件者的所有訊息都留在「已封鎖」，驗證碼也一樣。</string>
    <string name="onb_mode_smart">智慧</string>
    <string name="onb_mode_smart_desc">將未知寄件者的訊息留在「已封鎖」，但不含連結的驗證碼可以通過。建議使用。</string>
    <string name="onb_mode_off">關閉</string>
    <string name="onb_mode_off_desc">不篩選未知寄件者。你自訂的封鎖規則仍然有效。</string>
    <string name="onb_mode_warning_title">銀行與驗證碼訊息須知</string>
    <string name="onb_mode_warning_body">在嚴格模式下，未知寄件者傳來的銀行通知、物流更新及一次性驗證碼都會留在「已封鎖」，驗證碼也不例外。你不會收到通知，因此在等待這類訊息時，請查看「已封鎖」。</string>
    <string name="onb_oem_title">讓uMessage持續執行</string>
    <string name="onb_oem_body_known">%1$s手機經常會停止背景中的應用程式，導致訊息延遲。請完成以下步驟一次。</string>
    <string name="onb_oem_body_generic">部分手機會停止背景中的應用程式，導致訊息延遲。請允許uMessage不受限制地執行。</string>
    <string name="onb_oem_manual_hint">如果畫面沒有開啟，請在「設定」中搜尋顯示的名稱。</string>
    <string name="onb_oem_xiaomi">小米、Redmi或Poco</string>
    <string name="onb_oem_huawei">華為或榮耀</string>
    <string name="onb_oem_oppo">Oppo、Realme或OnePlus</string>
    <string name="onb_oem_step_autostart">允許自動啟動</string>
    <string name="onb_oem_step_battery_xiaomi">將省電模式設為「無限制」</string>
    <string name="onb_oem_step_samsung_sleep">將uMessage從休眠應用程式中移除</string>
    <string name="onb_oem_step_samsung_sleep_desc">在「電池」的「背景使用限制」中，確認uMessage不在「休眠應用程式」或「深度休眠應用程式」裡。</string>
    <string name="onb_oem_step_huawei_launch">手動管理啟動</string>
    <string name="onb_oem_step_huawei_launch_desc">在「應用程式啟動管理」中，將uMessage設為「手動管理」，並開啟全部三個開關。</string>
    <string name="onb_oem_step_oppo_startup">允許自動啟動及背景活動</string>
    <string name="onb_oem_step_ignore_battery">忽略電池最佳化</string>
    <string name="onb_oem_step_app_info">檢查應用程式設定</string>
    <string name="onb_oem_step_app_info_desc">開啟uMessage的應用程式頁面，檢查電池與權限設定。</string>
    <string name="onb_done_title">一切就緒</string>
    <string name="onb_done_body">uMessage已準備就緒。被攔下的訊息會顯示在「已封鎖」，輕觸一下即可允許寄件者。</string>
