<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The Google Play build has no automatic forwarding: the screen is not in the manifest at all, so it cannot
             be started or even found (it was merely disabled before). SEND_SMS stays: it is what a default SMS app
             uses to send the user's own messages. The forwarding code itself is compiled in (it is woven into the
             spam engine and database), but nothing can reach it: see ForwardingAvailability. -->
        <activity
            android:name=".ui.spam.ForwardingActivity"
            tools:node="remove" />
    </application>
</manifest>
